# Copy to .env.local and fill in. .env.local is ignored by git; never commit it.
# Devnet only: the wallet below pays for every mint with test funds.

# The minting wallet's 12-word seed phrase, one line, no quotes. A devnet wallet
# funded at the Voyage faucet (https://voyage.moi.technology/faucet/). Make a new
# one when you take this over; nothing ties the site to the old wallet.
ADMIN_MNEMONIC=

# The collection asset on devnet. Printed by scripts/create-collection.mjs,
# which creates the collection from the wallet above. New after every reset.
NEXT_PUBLIC_ASSET_ID=

# Pinata: keeps the images and each token's metadata on IPFS.
# Pinata dashboard, API Keys, New Key (pinFileToIPFS and pinJSONToIPFS, plus
# read access to the pin list for recovery). The JWT, not the key pair.
PINATA_JWT=

# Optional: the IPFS folder with the gallery images. The code has a default.
NEXT_PUBLIC_FOLDER_CID=

# Optional: enables the recovery routes (/api/snapshot, /api/recover,
# /api/reload) on this machine only. Generate with: openssl rand -hex 32.
# Leave empty on Vercel.
RECOVERY_SECRET=
